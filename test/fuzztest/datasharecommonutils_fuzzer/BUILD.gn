##############################hydra-fuzz########################################
import("//build/config/features.gni")
import("//build/test.gni")
import("//foundation/distributeddatamgr/data_share/datashare.gni")

##############################fuzztest##########################################
ohos_fuzztest("DataShareCommonUtilsFuzzTest") {
  module_out_path = "data_share/data_share"

  include_dirs = [
    "${datashare_innerapi_path}/common/include",
    "${datashare_common_native_path}/include",
  ]

  fuzz_config_file =
      "//foundation/distributeddatamgr/data_share/test/fuzztest/datasharecommonutils_fuzzer"

  cflags = [
    "-Dprivate=public",
    "-Dprotected=public",
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  sources = [
    "datasharecommonutils_fuzzer.cpp",
    "${datashare_common_native_path}/src/datashare_string_utils.cpp",
    "${datashare_common_native_path}/src/datashare_uri_utils.cpp",
  ]

  deps = [ "${datashare_innerapi_path}/common:datashare_common" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_single",
    "kv_store:distributeddata_inner",
  ]
}

###############################################################################
group("fuzztest") {
  testonly = true

  deps = [ ":DataShareCommonUtilsFuzzTest" ]
}
###############################################################################
